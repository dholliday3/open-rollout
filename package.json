{
  "name": "open-rollout",
  "version": "0.1.0",
  "private": true,
  "description": "Guarded feature flag rollouts: step traffic up, watch guardrail metrics, roll back on a regression. Works with any flag provider.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./posthog": {
      "types": "./dist/posthog.d.ts",
      "default": "./dist/posthog.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepare": "node --run build",
    "type-check": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "check:package": "tsx scripts/check-package.ts",
    "quickstart": "tsx examples/quickstart.ts",
    "sim": "SIM_RUNS=400 SIM_CHAOS_RUNS=1000 vitest run src/sim",
    "live:posthog": "OPEN_ROLLOUT_POSTHOG_LIVE=1 vitest run src/adapters/posthog.live.test.ts",
    "mutate": "stryker run"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.20.5",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
}
