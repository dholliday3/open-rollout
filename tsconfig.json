{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "types": [],
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "open-rollout": ["./src/index.ts"],
      "open-rollout/posthog": ["./src/posthog.ts"],
      "open-rollout/datadog": ["./src/datadog.ts"],
      "open-rollout/tools": ["./src/tools.ts"]
    }
  },
  "include": ["src", "examples", "scripts/*.ts", "vitest.config.ts"]
}
